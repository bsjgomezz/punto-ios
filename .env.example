# Copiá este archivo a .env y completá los valores. NO subas .env a Git.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=puntoios
POSTGRES_USER=puntoios
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Default=Host=localhost;Port=5432;Database=puntoios;Username=puntoios;Password=
Cors__AllowedOrigins=http://localhost:3000

# --- Firebase (se completa en la Fase 2) ---
Firebase__ProjectId=punto-ios

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
